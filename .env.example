# Optional startup defaults. Prefer the web Settings page; saved online values take precedence.
# AD_DATA_DIR selects storage at startup. Secrets remain backend-only.
AD_COMFYUI_URL=http://127.0.0.1:8188
AD_ALLOW_PUBLIC_COMFYUI=false
AD_LLM_BASE_URL=http://127.0.0.1:11434/v1
AD_LLM_MODEL=
AD_LLM_API_KEY=
# Optional vision-capable model using the same endpoint/key.
AD_VLM_MODEL=
# Model request timeout in seconds; also configurable on the Settings page (1-3600).
AD_LLM_TIMEOUT=600
AD_RENDER_TIMEOUT=1800
AD_MAX_ASSET_MB=512
AD_DATA_DIR=./data
